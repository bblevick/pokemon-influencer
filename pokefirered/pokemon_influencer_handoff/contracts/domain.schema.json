        "status",
        "roster_version",
        "prepared_at_seq",
        "evidence_cutoff_seq",
        "evidence_ids",
        "signature_lineage_id",
        "party",
        "changes"
      ],
      "additionalProperties": false
    },
    "battle_observation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "battle_observation"
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "save_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "branch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "battle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "choose_action",
            "forced_replacement"
          ]
        },
        "npc_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "knowledge_cutoff_seq": {
          "type": "integer",
          "minimum": 1
        },
        "own_active_party_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "own_party": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pokemon"
          },
          "minItems": 1,
          "maxItems": 6
        },
        "opponent_visible": {
