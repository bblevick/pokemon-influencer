              },
              "minItems": 0,
              "maxItems": 24,
              "uniqueItems": true
            }
          },
          "required": [
            "active_species_id",
            "displayed_level",
            "hp_bucket",
            "public_status",
            "revealed_moves"
          ],
          "additionalProperties": false
        },
        "known_memory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "minItems": 0,
          "maxItems": 8,
