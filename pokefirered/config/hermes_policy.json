{
  "schemaVersion": 1,
  "promptVersion": 1,
  "packetVersion": 1,
  "mandatoryOutcomeValues": [1, 2, 3],
  "maxPublicClaims": 2,
  "maxPrivateEvidence": 16,
  "maxRecallEpisodes": 8,
  "maxToolCalls": 6,
  "maxModelRequestsPerJob": 3,
  "maxLiveAttempts": 10,
  "maxOutputTokens": 1200,
  "maxInputBytes": 48000,
  "requestDeadlineSeconds": 15,
  "jobDeadlineSeconds": 55,
  "allowedTones": ["matter_of_fact", "competitive"],
  "publicDisclosure": ["TRAINER_BATTLE_RESULT", "POKEMON_SEEN"],
  "defaultMode": "offline"
}
