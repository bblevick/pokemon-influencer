{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Player safe post projection before binary paging",
 "type":"object","additionalProperties":false,
 "required":["postID","author","body"],
 "properties":{
  "postID":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "author":{"type":"string","pattern":"^trainer:fr:trainer:[0-9]{4}$"},
  "body":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[A-Za-z0-9 !?.',/-]+$"}
 }
}
