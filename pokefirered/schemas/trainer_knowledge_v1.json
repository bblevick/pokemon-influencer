{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trainer",
    "persona",
    "cutoffs",
    "directObservations",
    "reportedClaims",
    "retainedEpisodes",
    "observedSpeciesIDs",
    "unknowns",
    "observedChanges",
    "strategicInterpretation",
    "truncated"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "trainer": {
      "type": "object"
    },
    "persona": {
      "type": "object"
    },
    "cutoffs": {
      "type": "object"
    },
    "directObservations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reportedClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "attribution",
          "evidenceIDs",
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "reported"
          },
          "claim": {
            "type": "object"
          },
          "attribution": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidenceIDs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "retainedEpisodes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "episodeID",
          "battleID",
          "summary",
          "sourceEvidenceIDs",
          "visibility",
          "postID"
        ],
        "properties": {
          "episodeID": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "seenSpeciesIDs",
              "observedPlayerMoves",
              "ownAnnouncedMoves"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "trainer_loss",
                  "trainer_win",
                  "draw"
                ]
              },
              "seenSpeciesIDs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "observedPlayerMoves": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "ownAnnouncedMoves": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            }
          },
          "visibility": {
            "const": "actor_private"
          }
        }
      }
    },
    "observedSpeciesIDs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observedChanges": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object"
      }
    },
    "strategicInterpretation": {
      "type": "null"
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
